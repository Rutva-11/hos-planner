# ==============================================================================
# AURA HOS Planner - Backend Environment Configuration Template
# Copy this file to '.env' and fill in the values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Set to 'False' in production.
DEBUG=True

# Unique secret key for cryptographic signing. Generate a strong key for production.
# Mandatory if DEBUG=False.
SECRET_KEY=django-insecure-9^i_0$)xkq&nqbiy(=2w)4@6c$niw64rjjz7sbx4nn#!@mmvp7

# Comma-separated list of allowed hostnames (e.g. yourfrontend.domain.com,yourbackend.domain.com)
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.vercel.app,*.onrender.com

# ------------------------------------------------------------------------------
# CORS Settings
# ------------------------------------------------------------------------------
# Set to False in production to lock down cross-origin request policies.
CORS_ALLOW_ALL_ORIGINS=True

# Comma-separated list of specific origins allowed if CORS_ALLOW_ALL_ORIGINS=False.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://aura-hos.vercel.app

# ------------------------------------------------------------------------------
# Third-Party Integrations
# ------------------------------------------------------------------------------
# OpenRouteService API Key (for live routing calculations).
# If not configured, the service will fall back to high-fidelity mock route generation.
OPENROUTE_SERVICE_API_KEY=
# Alternative variable name supported by the routing service:
ORS_API_KEY=

# OpenRouter API Key (required for live AURA Copilot chat operations).
# If not configured, the copilot will fall back to local rule-based responses.
OPENROUTER_API_KEY=
