# ==============================================================================
# Aura HOS - Root .gitignore
# ==============================================================================

# Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Node / Frontend Build and Dependencies
node_modules/
Frontend/node_modules/
Frontend/dist/
Frontend/build/
Frontend/.env.local
Frontend/.env.development.local
Frontend/.env.test.local
Frontend/.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & Virtual Environments
venv/
.venv/
env/
.env_file
*.pyc
*.pyo
*.pyd
__pycache__/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Django Backend Local Files & Databases
backend/venv/
backend/.env
backend/db.sqlite3
backend/db.sqlite3-journal
backend/staticfiles/
backend/media/
backend/htmlcov/
*.log

# Sensitive Files
.env
.env.backup
.env.production
credentials.json
*.pem
*.key

.DS_Store
