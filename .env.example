# ==============================================================================
# Aura HOS - Unified Environment Configuration Template
# Copy this file to '.env' in your local environment, or distribute values to 
# Frontend/.env and backend/.env as required by your deployment.
# ==============================================================================

# ==============================================================================
# 🐍 BACKEND CONFIGURATION (backend/.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Set to 'False' in production. When False, SECRET_KEY and ALLOWED_HOSTS are strictly checked.
DEBUG=True

# Unique secret key used for cryptographic signing. Generate a strong key for production.
SECRET_KEY=django-insecure-9^i_0$)xkq&nqbiy(=2w)4@6c$niw64rjjz7sbx4nn#!@mmvp7

# Comma-separated list of allowed hostnames/IP addresses that this Django site can serve.
# Example: localhost,127.0.0.1,aura-hos.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.vercel.app,*.onrender.com

# Database Connection URL (Optional - defaults to local sqlite3 if not provided)
# Required in production deployments (e.g., Render using PostgreSQL).
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://user:password@localhost:5432/aurahos

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) Settings
# ------------------------------------------------------------------------------
# Set to False in production to restrict cross-origin requests to trusted origins.
CORS_ALLOW_ALL_ORIGINS=True

# Comma-separated list of specific origins allowed to make cross-site HTTP requests.
# Used only when CORS_ALLOW_ALL_ORIGINS is set to False.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://aura-hos.vercel.app

# ------------------------------------------------------------------------------
# Third-Party API Integrations
# ------------------------------------------------------------------------------
# OpenRouteService API Key (Required for live routing and geocoding).
# Get a key from: https://openrouteservice.org
# Note: If left blank, the application activates an offline mock database fallback.
OPENROUTE_SERVICE_API_KEY=
ORS_API_KEY=

# OpenRouter API Key (Required for live AURA Copilot AI Compliance chatbot).
# Get a key from: https://openrouter.ai
# Note: If left blank, the Copilot runs in offline rule-based fallback mode.
OPENROUTER_API_KEY=

# OpenRouter Model Routing configuration (Optional - defaults shown below)
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL_1=anthropic/claude-3-haiku
OPENROUTER_FALLBACK_MODEL_2=deepseek/deepseek-chat


# ==============================================================================
# ⚛️ FRONTEND CONFIGURATION (Frontend/.env)
# ==============================================================================

# URL of the backend Django API endpoint.
# Vite parses variables starting with "VITE_" and exposes them via `import.meta.env.VITE_API_URL`
VITE_API_URL=http://127.0.0.1:8000/api
